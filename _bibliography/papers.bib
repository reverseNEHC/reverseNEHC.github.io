@misc{chen2026contextual,
  title = {语境化的条件概率——对反事实条件句的形式化分析},
  year = {2026},
  pdf = {contextual-conditional-probability.pdf},
  additional_info = {陈序 · 第一作者},
  abstract = {本文围绕反事实条件句的形式化分析展开，主要从实际应用层面系统批判了刘易斯-斯塔纳克可能世界语义学中，因信息冗余问题所导致的丧失语境敏感性、造成认识论循环及忽视事件概率等缺陷。为了解决这些问题，在改进哈耶克条件概率理论的基础上，本文构建了一种“语境化条件概率语义学”，通过引入背景命题集、焦点集与相关性函数，将反事实的真值载体从整体可能世界的相似性比较转化为在紧致相关前提集上的客观条件概率计算，保持了反事实判断的客观性与可检验性，同时在形式层面实现了对冗余信息的有效过滤与语境敏感性的精准刻画，展现出更强的解释力与适用性。进一步地，本文尝试借助贝叶斯模型整合多语境条件概率，初步量化了反事实的稳定性，为因果关系的解释提供了新的形式化启发。},
  selected = {true}
}

@misc{chen2025playbour,
  title = {社交媒体平台用户“玩劳动”异化研究——以小红书平台为例},
  year = {2025},
  pdf = {social-media-playbour.pdf},
  additional_info = {陈序 · 第二作者},
  abstract = {随着数字经济的快速发展，社交媒体用户的休闲行为逐渐演变为隐性的“玩劳动”。小红书用户在平台上深度分享与互动的过程中，产生了明显的“玩劳动”异化特征。通过混合研究方法（半结构化访谈与问卷调查）分析发现：小红书用户的异化感知程度与“玩劳动”强度呈正相关，且有多维表征。时间维度上，休闲时间与劳动时间的边界模糊；社会关系维度上，社交互动被简化为量化指标，人际关系趋向功利化；认知与创作自主性维度上，算法推荐机制导致信息茧房，用户原创性被数据绩效取代。对此，个体需通过反算法实践重构主体性，平台应建立数据分红与算法透明机制，并通过区块链技术探求去中心化治理模式，构建多元共治秩序。本研究为解析社交媒体中的“玩劳动”异化提供了实证依据，对平衡平台利益与用户权益具有现实意义。},
  selected = {false}
}
